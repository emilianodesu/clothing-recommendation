# Copiar no es necesario: project.py bootstrap genera .env con valores privados.
# Mantener este archivo sin contraseñas reales. .env no se versiona.
COMPOSE_PROJECT_NAME=hmrec_local
HMREC_UID=1000
HMREC_GID=1000
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
API_PORT=8000
UI_PORT=8501
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
POSTGRES_PASSWORD=GENERATED_BY_BOOTSTRAP
HM_APP_PASSWORD=GENERATED_BY_BOOTSTRAP
HM_AIRFLOW_PASSWORD=GENERATED_BY_BOOTSTRAP
HM_MLFLOW_PASSWORD=GENERATED_BY_BOOTSTRAP
