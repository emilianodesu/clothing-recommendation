  "decisions_and_limits": [
    {
      "decision": "Use an isolated managed worktree; official demos use a clean local clone with independently generated configuration.",
      "reason": "Preserve main and private local artifacts.",
      "cost_if_wrong": "Extra checkout setup and storage; source identity is checked in every job."
    },
    {
      "decision": "Record the exact Q3 brief manually because the task helper accepts Task N headings, whereas this approved plan uses Q3.",
      "reason": "Do not rewrite the approved plan to satisfy a helper parser.",
      "cost_if_wrong": "Manual tracking could omit a step; the task checklist, full review and verification record cover it."
    },
    {
      "decision": "Build contexts come from the worktree; scratch resolution/bootstrap and official clone stay under the existing shared project directory.",
      "reason": "Colima does not mount the managed .codex worktree path.",
      "cost_if_wrong": "Stale copies could affect checks; official clean-clone demos verify the pinned executable commit without code mounts."
    },
    {
      "decision": "Supplement the temporary build CA bundle only with trusted Homebrew OpenSSL certificates already on this host.",
      "reason": "The system CA file alone could not validate the PyTorch package registry in this network. TLS verification remained enabled.",
      "cost_if_wrong": "Other networks may need their own locally trusted CA; no trust bundle or credential is copied to mac24."
    },
    {
      "decision": "Preserve the historical secondary Airflow lock and append only the uv-generated LightGBM 4.7.0 no-deps hash block; the main uv.lock resolved normally.",
      "reason": "Universal Airflow re-resolution tried Python >=3.15 outside the supported Python 3.12 image. Existing NumPy/SciPy pins satisfy LightGBM.",
      "cost_if_wrong": "Airflow deployment still needs its scheduled integration validation; Q3 jobs do not use Airflow."
    },
    {
      "decision": "Replay only external H/G retrieval and require byte-identical candidates; charge original external graph construction and rebuild four internal weeks per attempt.",
      "reason": "Measure preparation cost without treating reused data as free or repeating baseline evaluation.",
      "cost_if_wrong": "No shared internal cache means more compute/disk; real H&M resource costs must be measured in mac24."
    }
  ],
  "portability_fix": "Normalize Docker nanosecond timestamps to microseconds before datetime.fromisoformat, preserving the declared Python 3.9+ host contract.",
  "limits": [
    "Synthetic metrics do not establish H&M quality or full-scale RAM/time.",
    "A separate external MLflow integration test was skipped; model tracking was not changed by Q3.",
    "AMD64 dependency resolution is verified, but runtime execution was observed only on ARM64.",
    "Q4 selection, T4 service/model transport and test evaluation remain pending."
